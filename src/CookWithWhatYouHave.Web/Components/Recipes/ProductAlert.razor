<section class="alert alert-warning mb-3">
    <h2 class="h5 alert-heading">@ProductName</h2>
    <p class="mb-2">@Message</p>
    <div>
        @if (!string.IsNullOrWhiteSpace(NutriScore))
        {
            <span class="badge text-bg-dark me-2">Nutri-Score @NutriScore.ToUpperInvariant()</span>
        }
        @if (NovaGroup is not null)
        {
            <span class="badge text-bg-dark">NOVA @NovaGroup</span>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public string ProductName { get; set; } = "";

    [Parameter]
    public string? NutriScore { get; set; }

    [Parameter]
    public int? NovaGroup { get; set; }

    [Parameter, EditorRequired]
    public string Message { get; set; } = "";
}
