<section class="card mb-3">
    <div class="card-body">
        <h2 class="h5 card-title">Ingredientes</h2>
        <div class="row g-3">
            <div class="col-md-6">
                <h3 class="h6">Ya los tienes</h3>
                @if (Used.Count == 0)
                {
                    <p class="text-secondary mb-0">Ninguno indicado.</p>
                }
                else
                {
                    <ul class="mb-0">
                        @foreach (var item in Used)
                        {
                            <li @key="item">@item</li>
                        }
                    </ul>
                }
            </div>
            <div class="col-md-6">
                <h3 class="h6">Te falta</h3>
                @if (Missing.Count == 0)
                {
                    <p class="text-secondary mb-0">No falta nada.</p>
                }
                else
                {
                    <ul class="mb-0">
                        @foreach (var item in Missing)
                        {
                            <li @key="item">@item</li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<string> Used { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<string> Missing { get; set; } = [];
}
